{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rescue.action-result/v1",
  "title": "rescue.action-result/v1",
  "description": "SPEC §2.2/§4.3 terminal ActionResult, including rejection and retained partial costs; scripted sensing returns observations, never truth-backed beliefs.",
  "type": "object",
  "properties": {
    "instance_id": {
      "type": "string",
      "minLength": 1
    },
    "action_id": {
      "type": "string",
      "enum": [
        "A001",
        "A002",
        "A003",
        "A004",
        "A005",
        "A006",
        "A007",
        "A008",
        "A009",
        "A010",
        "A011",
        "A012",
        "A013",
        "A014",
        "A015",
        "A016",
        "A017",
        "A018",
        "A019",
        "A020",
        "A021",
        "A022",
        "A023",
        "A024",
        "A025",
        "A026",
        "A027",
        "A028",
        "A029",
        "A030",
        "A031",
        "A032",
        "A033",
        "A034",
        "A035",
        "A036",
        "A037",
        "A038",
        "A039",
        "A040",
        "A041",
        "A042",
        "A043",
        "A044",
        "A045",
        "A046",
        "A047",
        "A048",
        "A049",
        "A050",
        "A051",
        "A052",
        "A053",
        "A054",
        "A055",
        "A056",
        "A057",
        "A058",
        "A059",
        "A060",
        "A061",
        "A062",
        "A063",
        "A064",
        "A065",
        "A066"
      ]
    },
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "task_ref": {
      "anyOf": [
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2,
          "description": "[task instance id, revision], not a catalog task type."
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "rejected",
        "succeeded",
        "partial",
        "failed",
        "canceled"
      ]
    },
    "rejection_code": {
      "type": "string",
      "enum": [
        "none",
        "no_capability",
        "incompatible",
        "insufficient",
        "busy",
        "stale",
        "unauthorized"
      ]
    },
    "failure_code": {
      "type": "string",
      "enum": [
        "none",
        "blocked",
        "lost_link",
        "timeout",
        "sensor",
        "model",
        "hazard",
        "actuator",
        "energy"
      ]
    },
    "feedback_zh": {
      "type": "string"
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cost": {
      "type": "object",
      "properties": {
        "time_s": {
          "type": "number",
          "minimum": 0
        },
        "energy_Wh": {
          "type": "number",
          "minimum": 0
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "cpu_s": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "time_s",
        "energy_Wh",
        "bytes",
        "cpu_s"
      ],
      "additionalProperties": false
    },
    "backend_mode": {
      "type": "string",
      "minLength": 1
    },
    "params": {
      "type": "object"
    }
  },
  "required": [
    "instance_id",
    "action_id",
    "agent_id",
    "task_ref",
    "status",
    "rejection_code",
    "failure_code",
    "feedback_zh",
    "observations",
    "evidence_ids",
    "cost",
    "backend_mode",
    "params"
  ],
  "additionalProperties": false,
  "$defs": {
    "observation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "by": {
          "type": "string",
          "minLength": 1
        },
        "t": {
          "type": "number",
          "minimum": 0
        },
        "about": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "values": {
          "type": "object"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "by",
        "t",
        "about",
        "kind",
        "values",
        "confidence",
        "model"
      ],
      "additionalProperties": false
    }
  }
}
