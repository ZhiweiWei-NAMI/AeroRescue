{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rescue.upstream-semantics/v1",
  "title": "rescue.upstream-semantics/v1",
  "description": "SPEC §3.1 semantic annotation boundary; no elevation or generated visual perception.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "rescue.upstream-semantics/v1"
    },
    "source": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "upstream_annotation",
            "authored"
          ]
        },
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "terrain_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "producer",
        "terrain_ref",
        "note"
      ],
      "additionalProperties": false
    },
    "frame": {
      "type": "object",
      "properties": {
        "crs": {
          "const": "local_ENU_m"
        },
        "bounds_m": {
          "type": "array",
          "prefixItems": [
            {
              "const": 0
            },
            {
              "const": 0
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4,
          "description": "Planar local ENU bounds [0, 0, width, height], metres; elevation ignored."
        }
      },
      "required": [
        "crs",
        "bounds_m"
      ],
      "additionalProperties": false
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "class": {
            "type": "string",
            "minLength": 1,
            "description": "Known: building, road, tree, tree_cluster, water, open_area, slope, facility, station, coast, underground, bridge. Unknown classes must be retained as unknown with a warning."
          },
          "geometry": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "polygon",
                  "polyline",
                  "point"
                ]
              },
              "coords": {
                "type": "array",
                "items": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                },
                "minItems": 1
              }
            },
            "required": [
              "type",
              "coords"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "point"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "coords": {
                      "maxItems": 1
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "polyline"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "coords": {
                      "minItems": 2
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "polygon"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "coords": {
                      "minItems": 3
                    }
                  }
                }
              }
            ]
